    {
     "id": "SB1HO3msF1VK5cjv-39zsvdVKxe7cw",
     "type": "button",
     "propertyName": "",
     "componentName": "button1",
     "label": "Sign Up",
     "labelAlign": "right",
     "parentId": "TgCtm3_mqkx-YlaJqZutaS0K6yDADn",
     "isDynamic": false,
     "actionConfiguration": {
      "_type": "action-config",
      "actionName": "Execute Script",
      "actionOwner": "shesha.common",
      "handleFail": false,
      "handleSuccess": false,
      "actionArguments": {
       "expression": "// 1. Friendly checks before calling the server\r\nif (!data.firstName || !data.lastName || !data.emailAddress || !data.password) {\r\n  message.error(\"Please fill in all required fields.\");\r\n  return;\r\n}\r\nif (data.password !== data.confirmPassword) {\r\n  message.error(\"Passwords do not match.\");\r\n  return;\r\n}\r\n\r\n// 2. Create the account\r\ntry {\r\n  await http.post(\"/api/services/app/Registration/Register\", {\r\n    emailAddress: data.emailAddress,\r\n    password: data.password,\r\n    confirmPassword: data.confirmPassword,\r\n    firstName: data.firstName,\r\n    lastName: data.lastName,\r\n    mobileNumber: data.mobileNumber,\r\n    driversLicenceNumber: data.driversLicenceNumber,\r\n    licenceExpiryDate: data.licenceExpiryDate\r\n  });\r\n\r\n  // 3. Success → go to login\r\n  message.success(\"Account created! Please log in.\");\r\n  window.location.href = \"/login\";\r\n} catch (e) {\r\n  message.error(e?.response?.data?.error?.message ?? \"Could not create your account\");\r\n}"
      }
     },
     "buttonType": "default",
     "version": 10,
