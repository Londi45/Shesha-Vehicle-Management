   "componentName": "button1",
   "label": "Update Profile",
   "labelAlign": "right",
   "parentId": "root",
   "isDynamic": false,
   "actionConfiguration": {
    "_type": "action-config",
    "actionName": "Execute Script",
    "actionOwner": "shesha.common",
    "handleFail": false,
    "handleSuccess": true,
    "onSuccess": {
     "actionName": "Refresh",
     "actionOwner": "shesha.form",
     "_type": "action-config"
    },
    "actionArguments": {
     "expression": "try {\r\n  const response = await http.put(\"/api/services/app/Customer/UpdateMyProfile\", {\r\n    firstName: data.firstName,\r\n    lastName: data.lastName,\r\n    emailAddress: data.emailAddress,\r\n    mobileNumber: data.mobileNumber\r\n  });\r\n  form.setFieldsValue(response.data.result);\r\n  message.success(\"Profile saved\");\r\n} catch (e) {\r\n  message.error(e?.response?.data?.error?.message ?? \"Could not save your profile\");\r\n}"
    }
   },
   "buttonType": "primary",
   "version": 10,
   "sortOrder": 0,
